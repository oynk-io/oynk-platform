# Server-only values. Add to the API deployment's environment / secret manager.
# This example is documentation; the API does not load .env.funding.example.
PAYSTACK_SECRET_KEY=
# Provider registry key. PAYSTACK is the first adapter; future VFD/Wema
# adapters implement the same server-side interface without changing clients.
OYNK_DEFAULT_FIAT_PROVIDER=PAYSTACK
SOCKETFI_CLIENT_ID=sf_client_live_u3zqxglr2dhozi7z5z73o3wchwkm
# The secret paired with Oynk's SocketFi client ID. Backend only.
# The API uses it to fetch and cache SocketFi's public signing key automatically.
SOCKETFI_CLIENT_SECRET=
SOCKETFI_API_URL=https://api.socket.fi
# Optional indicative NGN per USDC. Blank/expired means no estimate is shown.
# Ramp rates are configured on the Soroban orchestrator. The API reads
# quote_onramp/quote_offramp and does not maintain an independent FX rate.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=Oynk
AFRICASTALKING_API_URL=https://api.africastalking.com/version1/messaging

# Read-only USDC smart-account balances. Public network requires an HTTPS RPC provider.
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_PUBLIC_RPC_URL=

# Soroban protocol deployments. Keep TESTNET and PUBLIC addresses separate.
# Leave blank until the matching Vault, Pool, Orchestrator and Registry WASMs
# are deployed and verified on that network.
OYNK_VAULT_TESTNET=
OYNK_POOL_TESTNET=
OYNK_ORCHESTRATOR_TESTNET=
OYNK_PROVIDER_REGISTRY_TESTNET=
OYNK_VAULT_PUBLIC=
OYNK_POOL_PUBLIC=
OYNK_ORCHESTRATOR_PUBLIC=
OYNK_PROVIDER_REGISTRY_PUBLIC=
OYNK_RAMP_PROVIDER_TESTNET=
OYNK_RAMP_PROVIDER_PUBLIC=
# Dedicated manager/attester secret. Never use the protocol admin key here.
OYNK_RAMP_SIGNER_SECRET_TESTNET=
OYNK_RAMP_SIGNER_SECRET_PUBLIC=
RAMP_EXECUTION_INTERVAL_MS=5000
