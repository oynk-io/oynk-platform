# Server-only values. Add to the API deployment's environment / secret manager.
# This example is documentation; the API does not load .env.funding.example.
PAYSTACK_SECRET_KEY=
# Collection and payout providers can be changed independently without a
# client rebuild. OYNK_DEFAULT_FIAT_PROVIDER remains the fallback for both.
OYNK_DEFAULT_FIAT_PROVIDER=VFD
OYNK_FIAT_COLLECTION_PROVIDER=VFD
OYNK_FIAT_PAYOUT_PROVIDER=VFD
# VFD stable Oynk Pay accounts. Keep both credentials on the API server only.
VFD_CONSUMER_KEY=
VFD_CONSUMER_SECRET=
VFD_ENVIRONMENT=TEST
# Send this as Authorization: Bearer <value> from the VFD webhook gateway.
VFD_WEBHOOK_SECRET=
# Must match the wallet/reference prefix assigned by VFD.
VFD_WALLET_PREFIX=oynk
VFD_MERCHANT_NAME=Oynk Technologies
# Oynk's corporate settlement account. Customer funds stay in each user's
# dedicated 1-to-1 VFD account until the user initiates a conversion or payout.
VFD_PAYOUT_ACCOUNT_NUMBER=
# Oynk's corporate account for customer layaway collections and subsequent
# merchant settlement. Use a dedicated account where VFD has provisioned one.
# If blank, the API falls back to VFD_PAYOUT_ACCOUNT_NUMBER for compatibility.
VFD_MART_HOLDING_ACCOUNT_NUMBER=
# Configure these from Oynk's contracted VFD collection pricing. Sandbox may
# use zero. Fees are grossed up and shown before the temporary account opens.
VFD_COLLECTION_FEE_BPS=0
VFD_COLLECTION_FEE_FLAT_KOBO=0
VFD_BUSINESS_ACCOUNT_MODEL=ONE_TO_ONE

# Stellar settlement accounts. A classic G account must trust the matching
# issuer before it can be activated as a USDC settlement destination.
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PUBLIC_HORIZON_URL=https://horizon.stellar.org
USDC_TESTNET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_PUBLIC_ISSUER=
# VFD_COLLECTION_FEE_CAP_KOBO=
SOCKETFI_CLIENT_ID=sf_client_live_u3zqxglr2dhozi7z5z73o3wchwkm
# The secret paired with Oynk's SocketFi client ID. Backend only.
# The API uses it to fetch and cache SocketFi's public signing key automatically.
SOCKETFI_CLIENT_SECRET=
SOCKETFI_API_URL=https://api.socket.fi
# Optional indicative NGN per USDC. Blank/expired means no estimate is shown.
# Ramp rates are configured on the Soroban orchestrator. The API reads
# quote_onramp/quote_offramp and does not maintain an independent FX rate.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=Oynk
AFRICASTALKING_API_URL=https://api.africastalking.com/version1/messaging

# Read-only USDC smart-account balances. Public network requires an HTTPS RPC provider.
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_PUBLIC_RPC_URL=

# Soroban protocol deployments. Keep TESTNET and PUBLIC addresses separate.
# Leave blank until the matching Vault, Pool, Orchestrator and Registry WASMs
# are deployed and verified on that network.
OYNK_VAULT_TESTNET=
OYNK_POOL_TESTNET=
OYNK_ORCHESTRATOR_TESTNET=
OYNK_PROVIDER_REGISTRY_TESTNET=
OYNK_VAULT_PUBLIC=
OYNK_POOL_PUBLIC=
OYNK_ORCHESTRATOR_PUBLIC=
OYNK_PROVIDER_REGISTRY_PUBLIC=
OYNK_RAMP_PROVIDER_TESTNET=
OYNK_RAMP_PROVIDER_PUBLIC=
# Dedicated manager/attester secret. Never use the protocol admin key here.
OYNK_RAMP_SIGNER_SECRET_TESTNET=
OYNK_RAMP_SIGNER_SECRET_PUBLIC=
RAMP_EXECUTION_INTERVAL_MS=5000
