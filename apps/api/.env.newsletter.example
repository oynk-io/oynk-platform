# Add to apps/api/.env. Never put SMTP credentials in VITE_* variables.
EMAIL_PROVIDER=zoho-smtp
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=Oynk
EMAIL_FROM_ADDRESS=no-reply@oynk.io
EMAIL_REPLY_TO=support@oynk.io
# Public API origin used in unsubscribe links. Use your existing tunnel locally.
API_PUBLIC_URL=https://YOUR-OYNK-API
