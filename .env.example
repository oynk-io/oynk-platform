DATABASE_URL=postgres://postgres:postgres@localhost:5432/oynk_dashboard
MART_LEMONBOOKS_API_URL=http://127.0.0.1:5000
API_PORT=4000
# Comma-separated origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5176,https://oynk.io,https://console.oynk.io,https://control.oynk.io
VITE_API_URL=
VITE_NETWORK_ENV=Mainnet
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_CONSOLE_SITE_URL=http://localhost:5174
VITE_CONSOLE_URL=http://localhost:5174
VITE_CONTROL_URL=http://localhost:5176
VITE_DOCS_URL=http://localhost:4173
VITE_CONSUMER_PRODUCT_NAME=Oynk Pay
VITE_TRANSACTIONS_SITE_URL=http://localhost:5175
ADMIN_API_KEY=replace-with-at-least-32-random-characters

PUBLIC_SITE_URL=http://localhost:5173
REFERRAL_PUBLIC_URL=https://oynk.io
CONSOLE_SITE_URL=http://localhost:5174
CONTROL_SITE_URL=http://localhost:5176
API_PUBLIC_URL=http://localhost:4000
APP_ENV=development
PLATFORM_MODE=SANDBOX
# Keep false for the first public release until holding, expiry, refund and
# merchant-settlement production UAT has been signed off.
MART_LAYAWAY_ENABLED=true
MART_GLOBAL_ENABLED=true
EBAY_BROWSE_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_API_URL=https://api.ebay.com
EBAY_OAUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
CONSUMER_TIER3_ENABLED=true
CONSUMER_OFFLINE_PAY_ENABLED=true
OYNK_GO_ENABLED=true

AUTH_SESSION_COOKIE_NAME=oynk_session
AUTH_SESSION_TTL_HOURS=12
AUTH_PREAUTH_TTL_MINUTES=15
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

# Use development locally. Production Zoho SMTP requires an application-specific password.
EMAIL_PROVIDER=development
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=Oynk
EMAIL_FROM_ADDRESS=no-reply@oynk.io
EMAIL_REPLY_TO=support@oynk.io

# Phone OTP. Development returns the code to the mobile client only when the
# preview flag is true. To test a real number while keeping local fixtures,
# select africastalking and keep APP_ENV=development. Production must use the
# live provider and must disable the development-code preview.
PHONE_OTP_PROVIDER=development
PHONE_OTP_DEVELOPMENT_CODE_VISIBLE=true
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=Oynk
AFRICASTALKING_API_URL=https://api.africastalking.com/version1/messaging

# Use reliable paid RPCs in production.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SYNC_INTERVAL_MINUTES=5
SEED_OFFCHAIN_TRANSACTIONS=false
BSC_START_BLOCK=19746745
BSC_MIN_CHUNK_SIZE=500
BSC_INITIAL_CHUNK_SIZE=5000
BSC_MAX_CHUNK_SIZE=50000
BSC_CONFIRMATION_DEPTH=20
BSC_REORG_REWIND_BLOCKS=30
BSC_CHUNK_GROWTH_SUCCESS_RANGES=5
BSC_CHUNK_GROWTH_STEP=250
BSC_CHUNK_DELAY_MS=100
BSC_CHUNK_JITTER_MS=100
SOLANA_SIGNATURE_LIMIT=500
SOLANA_ADDITIONAL_SOURCE_ACCOUNTS=

# Keep 0 for direct access. Set only to the number of trusted, header-sanitizing
# reverse proxies in front of the production API (for example 1 behind Caddy).
TRUST_PROXY_HOPS=0
